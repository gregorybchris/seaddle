# Restrict this token by URL (localhost + the production domain) before deploying.
# It ships to the browser, so URL restriction is the only real protection.
VITE_MAPBOX_TOKEN=

# A Mapbox Studio style URL, e.g. mapbox://styles/you/abc123. Optional: without
# it both maps use the stock light style.
VITE_MAP_STYLE=

# "true" lists the roads that can be picked next beside the map, so a route can
# be built without pointing at one. Off by default; see src/site/flags.ts.
VITE_TURNINGS=
